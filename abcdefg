const featured = [
  {en:"Alishan", zh:"阿里山", region:"Nature",
   desc:"Wake up above the clouds and walk among ancient trees.",
   image:"https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=700&q=80"},
  {en:"Tainan", zh:"台南", region:"Culture",
   desc:"Explore old streets, temples, and delicious local snacks.",
   image:"https://images.unsplash.com/photo-1511818966892-d7d671e672a2?auto=format&fit=crop&w=700&q=80"},
  {en:"Kenting", zh:"墾丁", region:"Coast",
   desc:"Enjoy tropical beaches, sea breezes, and golden sunsets.",
   image:"https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=700&q=80"}
];

function createCard(place, isFeatured=false) {
  const card = document.createElement("article");
  card.className = "card";

  const img = document.createElement("img");
  img.src = place.image;
  img.alt = "Scenery in " + place.en;
  img.loading = "lazy";
  img.onerror = () => { img.style.display = "none"; };

  const content = document.createElement("div");
  content.className = "card-content";

  const title = document.createElement("h3");
  title.textContent = place.en + " · " + place.zh;

  const tag = document.createElement("span");
  tag.className = "region";
  tag.textContent = place.region;

  const description = document.createElement("p");
  description.textContent = place.desc;

  content.append(title, tag, description);

  if (isFeatured) {
    const save = document.createElement("button");
    save.className = "save";
    save.textContent = "♡ Save";
    save.setAttribute("aria-pressed", "false");
    save.addEventListener("click", () => {
      const saved = save.classList.toggle("saved");
      save.textContent = saved ? "♥ Saved" : "♡ Save";
      save.setAttribute("aria-pressed", String(saved));
    });
    content.append(save);
  }

  card.append(img, content);
  return card;
}

const featuredGrid = document.getElementById("featured");
featured.forEach(place => featuredGrid.append(createCard(place, true)));

const countyGrid = document.getElementById("countyGrid");
function renderCounties() {
  const query = document.getElementById("search").value.trim().toLowerCase();
  const region = document.getElementById("region").value;
  countyGrid.innerHTML = "";
  const filtered = places.filter(place => {
    const matchesQuery =
      (place.en + " " + place.zh + " " + place.desc)
        .toLowerCase().includes(query);
    return matchesQuery && (region === "All" || place.region === region);
  });
  document.getElementById("count").textContent =
    `Showing ${filtered.length} of 22 cities and counties`;
  filtered.forEach(place => countyGrid.append(createCard(place)));
}
document.getElementById("search").addEventListener("input", renderCounties);
document.getElementById("region").addEventListener("change", renderCounties);
renderCounties();

const recommendations = {
  nature: {
    title:"🌿 Alishan or Nantou",
    text:"Enjoy green mountains, forest walks, fresh air, and beautiful sunrise views."
  },
  food: {
    title:"🍜 Tainan",
    text:"Explore historic streets, visit temples, and try delicious traditional snacks."
  },
  beach: {
    title:"🌊 Kenting or Penghu",
    text:"Relax beside the ocean, enjoy the sunshine, and watch a colorful sunset."
  },
  city: {
    title:"🏙️ Taipei or Taichung",
    text:"Explore cafés, museums, shopping areas, and lively night markets."
  }
};

document.getElementById("plan").addEventListener("click", () => {
  const choice = document.getElementById("mood").value;
  const item = recommendations[choice];
  document.getElementById("result").innerHTML =
    `<strong>${item.title}</strong><br>${item.text}`;
});

document.getElementById("random").addEventListener("click", () => {
  const keys = Object.keys(recommendations);
  const item = recommendations[keys[Math.floor(Math.random() * keys.length)]];
  document.getElementById("result").innerHTML =
    `<strong>${item.title}</strong><br>${item.text}`;
});
</script>
